{
  "env": {
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(php artisan test *)",
      "Bash(php artisan route:list *)",
      "Bash(php artisan config:show *)",
      "Bash(vendor/bin/pint *)",
      "Bash(vendor/bin/phpunit *)",
      "Bash(composer show *)",
      "Bash(npx vitest run *)",
      "Bash(npx vite build)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(php artisan tinker *)",
      "Bash(mysql *)"
    ],
    "deny": [
      "Read(./**/vendor/**)",
      "Read(./**/node_modules/**)",
      "Read(./**/storage/**)",
      "Read(./**/dist/**)",
      "Read(./**/public/build/**)",
      "Read(./**/*.log)",
      "Read(./**/composer.lock)",
      "Read(./**/package-lock.json)",
      "Read(./**/.env)",
      "Edit(./**/.env)",
      "Read(./**/ukwms_ssl/**)",
      "Read(./**/backup_sipenamas_production/**)",
      "Edit(./**/backup_sipenamas_production/**)",
      "Bash(*DB_PROD*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(php artisan migrate:fresh*)",
      "Bash(php artisan migrate:reset*)",
      "Bash(php artisan db:wipe*)",
      "Bash(php artisan migrate)",
      "Bash(php artisan migrate *)",
      "Bash(php artisan db:seed *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/session-context.sh\" 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/pint-php.sh\" 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "Pint"
          }
        ]
      }
    ]
  }
}
